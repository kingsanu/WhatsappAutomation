# 🚀 WhatsApp API - Environment Configuration Example
# Copy this file to .env and configure your values

# =============================================================================
# 🌐 SERVER CONFIGURATION
# =============================================================================
PORT=3000
API_PREFIX=api/v1
NODE_ENV=development

# =============================================================================
# 🔒 SECURITY CONFIGURATION
# =============================================================================
# API Keys (comma-separated for multiple keys)
API_KEYS=your-secret-api-key-1,your-secret-api-key-2

# Security Features (true/false)
ENABLE_API_KEY_AUTH=true
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_LOGGING=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/whatsapp-api

# =============================================================================
# 📱 WHATSAPP CONFIGURATION
# =============================================================================
# Device Information
WHATSAPP_DEVICE_NAME=WhatsApp API Server
WHATSAPP_BROWSER=Chrome
WHATSAPP_VERSION=4.0.0

# Session Management
MAX_ACTIVE_SESSIONS=1000
MAX_RAM_USAGE_MB=20480
SESSION_CLEANUP_INTERVAL=3600000
SESSION_IDLE_TIMEOUT_MS=0
QR_CODE_TIMEOUT=60000

# Reconnection Settings
MAX_RECONNECTION_ATTEMPTS=3
MAX_CONFLICT_ATTEMPTS=2
RECONNECTION_BASE_DELAY=3000
RECONNECTION_MAX_DELAY=300000

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=300000
MAX_ERROR_COUNT=10
ERROR_RESET_INTERVAL=3600000

# =============================================================================
# 🔗 WEBHOOK CONFIGURATION
# =============================================================================
# Optional: Webhook URL for message events
WEBHOOK_URL=https://your-domain.com/webhook

# =============================================================================
# 📊 MONITORING & HEALTH
# =============================================================================
ENABLE_HEALTH_MONITORING=true
HEALTH_CHECK_INTERVAL=300000
RESPONSE_TIME_THRESHOLD=5000
ERROR_RATE_THRESHOLD=0.1
INACTIVITY_THRESHOLD=3600000

# Reconnection Monitoring
RECONNECTION_COOLDOWN=60000
MAX_RECONNECTION_FAILURES=5
EXTENDED_COOLDOWN=300000

# =============================================================================
# 💾 BACKUP & PERSISTENCE
# =============================================================================
ENABLE_SESSION_BACKUP=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30

# Restoration Settings
RESTORATION_BATCH_SIZE=10
RESTORATION_DELAY=2000
RESTORATION_RETRY_DELAY=300000
RESTORATION_MAX_RETRIES=3

# =============================================================================
# 🏷️ DEPLOYMENT & TRACKING
# =============================================================================
# Server Instance Identification
SERVER_INSTANCE_ID=whatsapp-api-001
NODE_ID=primary-node
DEPLOYMENT_VERSION=1.0.0

# =============================================================================
# 🔧 DEVELOPMENT SETTINGS
# =============================================================================
# Logging Levels (development only)
LOG_LEVEL=debug

# Enable Metrics Collection
ENABLE_METRICS=true

# =============================================================================
# 📝 USAGE EXAMPLES
# =============================================================================
# 
# Production Example:
# NODE_ENV=production
# API_KEYS=prod-key-123,backup-key-456
# MONGODB_URI=mongodb://user:pass@prod-cluster/whatsapp-api
# WEBHOOK_URL=https://api.yourcompany.com/whatsapp-webhook
# 
# Development Example:
# NODE_ENV=development
# API_KEYS=dev-test-key
# MONGODB_URI=mongodb://localhost:27017/whatsapp-api-dev
# ENABLE_API_KEY_AUTH=false
# ENABLE_RATE_LIMITING=false
#
# =============================================================================